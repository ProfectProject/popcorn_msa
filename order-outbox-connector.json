{
  "name": "order-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",

    "database.hostname": "goorm-popcorn-prod-postgres.cds4g0gykt3t.ap-northeast-2.rds.amazonaws.com",
    "database.port": "5432",
    "database.user": "cdc_user",
    "database.password": "cdc123",
    "database.dbname": "popcorn_prod",
    "database.sslmode": "require",

    "plugin.name": "pgoutput",

    "schema.include.list": "orders",
    "table.include.list": "orders.outbox_events",

    "slot.name": "order_outbox_slot",
    "publication.name": "order_outbox_pub",
    "publication.autocreate.mode": "filtered",

    "snapshot.mode": "no_data",

    "topic.prefix": "popcorn-order-cdc",

    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",

    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "order-events",

    "transforms.outbox.table.expand.json.payload": "true",

    "transforms.outbox.table.field.event.id": "event_id",
    "transforms.outbox.table.field.event.type": "event_type",
    "transforms.outbox.table.field.event.key": "partition_key",
    "transforms.outbox.table.field.event.payload": "event_data",
    "transforms.outbox.fields.event.payload.type": "json",

    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false"
  }
}
