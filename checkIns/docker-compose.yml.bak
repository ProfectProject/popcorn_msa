services:
  checkIns-app:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "8082:8082"
    environment:
      - SPRING_PROFILES_ACTIVE=local
      - DB_HOST=db
      - DB_PORT=5432
      - DB_NAME=popcorn_db
      - DB_USERNAME=qr_app
      - DB_PASSWORD=1234
      - QR_MIGRATOR_PASSWORD=qr321
      - QR_APP_PASSWORD=qr123
    env_file:
      - .env.qr
    depends_on:
      - db
    networks:
      - checkIns-network
    restart: unless-stopped

  db:
    image: postgres:15-alpine
    environment:
      POSTGRES_DB: popcorn_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: 1234
    ports:
      - "5433:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    networks:
      - checkIns-network
    restart: unless-stopped

volumes:
  postgres_data:

networks:
  checkIns-network:
    driver: bridge